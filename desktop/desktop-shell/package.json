{
  "name": "@yumpoo/desktop-shell",
  "productName": "Yumpoo Desktop",
  "version": "1.1.3",
  "description": "Yumpoo Desktop",
  "author": "Yumpoo",
  "private": true,
  "type": "commonjs",
  "main": "dist/main/index.js",
  "engines": {
    "node": "24.14.x"
  },
  "scripts": {
    "start": "pnpm run build && electron .",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.diagnostics.json",
    "test": "vitest run",
    "build": "pnpm run typecheck && node scripts/build.cjs && pnpm --filter @yumpoo/web-app build:desktop-menu && node scripts/menu-licenses.cjs",
    "package:win": "pnpm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "@yumpoo/preload-contract": "workspace:*",
    "electron": "43.7.9",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "resedit": "3.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
