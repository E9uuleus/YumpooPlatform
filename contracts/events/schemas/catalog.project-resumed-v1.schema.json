{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/catalog.project-resumed-v1.schema.json",
  "title": "Project resumed",
  "allOf": [
    {
      "$ref": "event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "catalog.project_resumed"
        },
        "eventVersion": {
          "const": 1
        },
        "aggregateType": {
          "const": "Project"
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "code",
            "rowVersion"
          ],
          "properties": {
            "projectId": {
              "type": "string",
              "format": "uuid"
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
            },
            "rowVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  ]
}
