{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/catalog.project-moved-to-workspace-v1.schema.json",
  "title": "Project moved to workspace",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "catalog.project_moved_to_workspace" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "Project" },
        "aggregateVersion": { "type": "integer", "minimum": 1 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectId", "code", "fromLifecycle", "toLifecycle", "rowVersion", "fromWorkspaceId", "toWorkspaceId"],
          "properties": {
            "projectId": { "type": "string", "format": "uuid" },
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
            "fromLifecycle": { "enum": ["DRAFT", "ACTIVE"] },
            "toLifecycle": { "enum": ["DRAFT", "ACTIVE"] },
            "rowVersion": { "type": "integer", "minimum": 1 },
            "fromWorkspaceId": { "type": "string", "format": "uuid" },
            "toWorkspaceId": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  ]
}
