{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/catalog.product-restored-v1.schema.json",
  "title": "Product restored",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "catalog.product_restored" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "Product" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["productId", "code", "name", "status", "ownerUserId", "fromStatus", "toStatus"],
          "properties": {
            "productId": { "type": "string", "format": "uuid" }, "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "status": { "const": "ACTIVE" }, "ownerUserId": { "type": "string", "format": "uuid" },
            "fromStatus": { "const": "ARCHIVED" }, "toStatus": { "const": "ACTIVE" }
          }
        }
      }
    }
  ]
}
