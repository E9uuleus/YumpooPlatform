{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/catalog.project-created-v2.schema.json",
  "title": "Project created v2",
  "allOf": [
    {
      "$ref": "event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "catalog.project_created"
        },
        "eventVersion": {
          "const": 2
        },
        "aggregateType": {
          "const": "Project"
        },
        "aggregateVersion": {
          "const": 0
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "workspaceId",
            "code",
            "name",
            "lifecycle",
            "ownerUserId",
            "initializedContentCount"
          ],
          "properties": {
            "projectId": {
              "type": "string",
              "format": "uuid"
            },
            "workspaceId": {
              "type": "string",
              "format": "uuid"
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "lifecycle": {
              "const": "ACTIVE"
            },
            "ownerUserId": {
              "type": "string",
              "format": "uuid"
            },
            "initializedContentCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  ]
}
