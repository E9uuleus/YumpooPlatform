{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/workitem.work-item-parent-changed-v1.schema.json",
  "title": "Work Item parent changed",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    { "type": "object", "properties": {
      "eventType": { "const": "workitem.work_item_parent_changed" },
      "eventVersion": { "const": 1 },
      "aggregateType": { "const": "WorkItemRelation" },
      "aggregateVersion": { "const": 0 },
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationId", "relationType", "leftWorkItemId", "rightWorkItemId", "leftProjectId", "rightProjectId", "oldRelationId", "oldParentWorkItemId", "newParentWorkItemId", "childWorkItemId"],
        "properties": {
          "relationId": { "type": "string", "format": "uuid" },
          "relationType": { "const": "PARENT_CHILD" },
          "leftWorkItemId": { "type": "string", "format": "uuid" },
          "rightWorkItemId": { "type": "string", "format": "uuid" },
          "leftProjectId": { "type": "string", "format": "uuid" },
          "rightProjectId": { "type": "string", "format": "uuid" },
          "oldRelationId": { "type": "string", "format": "uuid" },
          "oldParentWorkItemId": { "type": "string", "format": "uuid" },
          "newParentWorkItemId": { "type": "string", "format": "uuid" },
          "childWorkItemId": { "type": "string", "format": "uuid" }
        }
      }
    } }
  ]
}
