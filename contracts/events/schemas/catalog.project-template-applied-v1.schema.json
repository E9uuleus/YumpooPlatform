{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/catalog.project-template-applied-v1.schema.json",
  "title": "Project template applied",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "catalog.project_template_applied" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "Project" },
        "aggregateVersion": { "const": 0 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId", "templateKey", "templateVersion",
            "initializedContentCount", "contentCodes"
          ],
          "properties": {
            "projectId": { "type": "string", "format": "uuid" },
            "templateKey": { "enum": ["RND", "PRE_SALES", "IMPLEMENTATION", "HYPERCARE"] },
            "templateVersion": { "type": "integer", "minimum": 1 },
            "initializedContentCount": { "type": "integer", "minimum": 1 },
            "contentCodes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" }
            }
          }
        }
      }
    }
  ]
}
