{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/workitem.content-archived-v1.schema.json",
  "title": "Content archived",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    { "type": "object", "properties": {
      "eventType": { "const": "workitem.content_archived" },
      "eventVersion": { "const": 1 },
      "aggregateType": { "const": "Content" },
      "aggregateVersion": { "type": "integer", "minimum": 1 },
      "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentId", "projectId", "code", "name", "workItemType", "status", "defaultViewType", "blueprintCode", "rowVersion", "changedFields"],
          "properties": {
            "contentId": { "type": "string", "format": "uuid" },
            "projectId": { "type": "string", "format": "uuid" },
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 80 },
            "workItemType": { "enum": ["REQUIREMENT", "TASK", "DEFECT"] },
            "status": { "enum": ["ACTIVE", "ARCHIVED"] },
            "defaultViewType": { "enum": ["TABLE", "KANBAN"] },
            "blueprintCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
            "rowVersion": { "type": "integer", "minimum": 0 },
            "changedFields": { "type": "array", "uniqueItems": true, "items": { "enum": ["name", "description", "defaultViewType", "viewConfig", "status"] } }
          }
        }
    } }
  ]
}
