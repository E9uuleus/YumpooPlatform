{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/identity.user-employment-returned-v1.schema.json",
  "title": "User employment returned",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "identity.user_employment_returned" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "User" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["userId", "runId", "fromStatus", "toStatus", "reasonCode", "authorizationVersion"],
          "properties": {
            "userId": { "type": "string", "format": "uuid" },
            "runId": { "type": "string", "format": "uuid" },
            "fromStatus": { "const": "LEFT" },
            "toStatus": { "const": "ACTIVE" },
            "reasonCode": { "const": "DIRECTORY_MEMBER_REAPPEARED" },
            "authorizationVersion": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  ]
}
