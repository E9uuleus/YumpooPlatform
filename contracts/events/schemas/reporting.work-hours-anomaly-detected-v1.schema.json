{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/reporting.work-hours-anomaly-detected-v1.schema.json",
  "title": "Work hours anomaly detected",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "reporting.work_hours_anomaly_detected" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "WorkHoursAlert" },
        "aggregateVersion": { "const": 1 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["userId", "workDate", "totalDurationMs", "thresholdMinutes"],
          "properties": {
            "userId": { "type": "string", "format": "uuid" },
            "workDate": { "type": "string", "format": "date" },
            "totalDurationMs": { "type": "integer", "minimum": 1 },
            "thresholdMinutes": { "type": "integer", "minimum": 60, "maximum": 1440 }
          }
        }
      }
    }
  ]
}
