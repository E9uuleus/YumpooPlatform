{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/catalog.project-purged-v1.schema.json",
  "title": "Project purged",
  "allOf": [
    {
      "$ref": "event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "catalog.project_purged"
        },
        "eventVersion": {
          "const": 1
        },
        "aggregateType": {
          "const": "Project"
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "purgedAt"
          ],
          "properties": {
            "projectId": {
              "type": "string",
              "format": "uuid"
            },
            "purgedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          }
        }
      }
    }
  ]
}
