{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/workitem.connection-deleted-v1.schema.json",
  "title": "workitem.connection_deleted",
  "allOf": [
    {
      "$ref": "event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "workitem.connection_deleted"
        },
        "eventVersion": {
          "const": 1
        },
        "aggregateType": {
          "const": "WorkItemConnection"
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectionId",
            "columnId",
            "columnName",
            "origin",
            "sourceProjectId",
            "sourceWorkItemId",
            "targetProjectId",
            "targetWorkItemId",
            "deleteReason"
          ],
          "properties": {
            "connectionId": {
              "type": "string",
              "format": "uuid"
            },
            "columnId": {
              "type": "string",
              "format": "uuid"
            },
            "columnName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "origin": {
              "enum": [
                "LINKED",
                "CREATED"
              ]
            },
            "sourceProjectId": {
              "type": "string",
              "format": "uuid"
            },
            "sourceWorkItemId": {
              "type": "string",
              "format": "uuid"
            },
            "targetProjectId": {
              "type": "string",
              "format": "uuid"
            },
            "targetWorkItemId": {
              "type": "string",
              "format": "uuid"
            },
            "deleteReason": {
              "const": "UNLINKED"
            }
          }
        }
      }
    }
  ]
}
