{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/catalog.workspace-updated-v1.schema.json",
  "title": "Workspace navigation fields updated",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "catalog.workspace_updated" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "Workspace" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspaceId", "code", "changedFields", "oldName", "newName", "oldSortOrder", "newSortOrder", "descriptionChanged"],
          "properties": {
            "workspaceId": { "type": "string", "format": "uuid" },
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
            "changedFields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["name", "description", "sortOrder"] }
            },
            "oldName": { "type": "string", "minLength": 1, "maxLength": 80 },
            "newName": { "type": "string", "minLength": 1, "maxLength": 80 },
            "oldSortOrder": { "type": "integer", "minimum": 0 },
            "newSortOrder": { "type": "integer", "minimum": 0 },
            "descriptionChanged": { "type": "boolean" }
          }
        }
      }
    }
  ]
}
