{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/workitem.work-item-rank-changed-v1.schema.json",
  "title": "Work Item rank changed",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    { "type": "object", "properties": {
      "eventType": { "const": "workitem.work_item_rank_changed" },
      "eventVersion": { "const": 1 },
      "aggregateType": { "const": "WorkItem" },
      "aggregateVersion": { "type": "integer", "minimum": 1 },
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workItemId", "projectId", "contentId", "itemNo", "statusCode", "placement", "anchorWorkItemId", "rowVersion"],
        "properties": {
          "workItemId": { "type": "string", "format": "uuid" },
          "projectId": { "type": "string", "format": "uuid" },
          "contentId": { "type": "string", "format": "uuid" },
          "itemNo": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[1-9][0-9]*$" },
          "statusCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
          "placement": { "enum": ["START", "BEFORE", "AFTER", "END"] },
          "anchorWorkItemId": { "type": ["string", "null"], "format": "uuid" },
          "rowVersion": { "type": "integer", "minimum": 1 }
        }
      }
    } }
  ]
}
