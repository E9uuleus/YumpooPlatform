{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/identity.app-manager-missing-detected-v1.schema.json",
  "title": "APP_MANAGER missing detected",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "identity.app_manager_missing_detected" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "AppManagerGovernanceState" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["previousAvailableCount", "currentAvailableCount", "triggerCode", "affectedUserId", "detectedAt"],
          "properties": {
            "previousAvailableCount": { "type": "integer", "minimum": 1 },
            "currentAvailableCount": { "const": 0 },
            "triggerCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" },
            "affectedUserId": { "type": ["string", "null"], "format": "uuid" },
            "detectedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }
          }
        }
      }
    }
  ]
}
