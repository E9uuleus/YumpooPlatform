{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/workitem.work-item-assignees-changed-v1.schema.json",
  "title": "Work Item assignees changed",
  "allOf": [
    {
      "$ref": "event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "workitem.work_item_assignees_changed"
        },
        "eventVersion": {
          "const": 1
        },
        "aggregateType": {
          "const": "WorkItem"
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workItemId",
            "projectId",
            "contentId",
            "itemNo",
            "previousAssigneeUserIds",
            "assigneeUserIds",
            "addedUserIds",
            "removedUserIds",
            "rowVersion"
          ],
          "properties": {
            "assigneeUserIds": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "workItemId": {
              "type": "string",
              "format": "uuid"
            },
            "projectId": {
              "type": "string",
              "format": "uuid"
            },
            "contentId": {
              "type": "string",
              "format": "uuid"
            },
            "itemNo": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,31}-[1-9][0-9]*$"
            },
            "rowVersion": {
              "type": "integer",
              "minimum": 1
            },
            "previousAssigneeUserIds": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "addedUserIds": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "removedUserIds": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  ]
}
