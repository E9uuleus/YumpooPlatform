{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/catalog.project-updated-v1.schema.json",
  "title": "Project updated",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "catalog.project_updated" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "Project" },
        "aggregateVersion": { "type": "integer", "minimum": 1 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectId", "code", "lifecycle", "changedFields"],
          "properties": {
            "projectId": { "type": "string", "format": "uuid" },
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
            "lifecycle": { "enum": ["DRAFT", "ACTIVE"] },
            "changedFields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["name", "description", "customerName", "customerReference", "deliverySite", "contactNote"]
              }
            }
          }
        }
      }
    }
  ]
}
