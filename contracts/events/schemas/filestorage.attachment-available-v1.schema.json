{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/filestorage.attachment-available-v1.schema.json",
  "title": "Attachment available",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    { "type": "object", "properties": {
      "eventType": { "const": "filestorage.attachment_available" },
      "eventVersion": { "const": 1 },
      "aggregateType": { "const": "Attachment" },
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attachmentId", "ownerType", "ownerId", "projectId", "fileName", "detectedMime", "sizeBytes", "uploadedByUserId", "rowVersion"],
        "properties": {
          "attachmentId": { "type": "string", "format": "uuid" },
          "ownerType": { "enum": ["WORK_ITEM", "WORK_ITEM_UPDATE"] },
          "ownerId": { "type": "string", "format": "uuid" },
          "projectId": { "type": "string", "format": "uuid" },
          "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
          "detectedMime": { "type": "string", "minLength": 1, "maxLength": 160 },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
          "uploadedByUserId": { "type": "string", "format": "uuid" },
          "rowVersion": { "type": "integer", "minimum": 0 }
        }
      }
    } }
  ]
}
