{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/workitem.work-item-relation-deleted-v1.schema.json",
  "title": "Work Item relation deleted",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    { "type": "object", "properties": {
      "eventType": { "const": "workitem.work_item_relation_deleted" },
      "eventVersion": { "const": 1 },
      "aggregateType": { "const": "WorkItemRelation" },
      "aggregateVersion": { "const": 1 },
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationId", "relationType", "leftWorkItemId", "rightWorkItemId", "leftProjectId", "rightProjectId", "deletedAt"],
        "properties": {
          "relationId": { "type": "string", "format": "uuid" },
          "relationType": { "enum": ["PARENT_CHILD", "RELATED", "BLOCKS", "SOURCE", "DUPLICATE"] },
          "leftWorkItemId": { "type": "string", "format": "uuid" },
          "rightWorkItemId": { "type": "string", "format": "uuid" },
          "leftProjectId": { "type": "string", "format": "uuid" },
          "rightProjectId": { "type": "string", "format": "uuid" },
          "deletedAt": { "type": "string", "format": "date-time" }
        }
      }
    } }
  ]
}
