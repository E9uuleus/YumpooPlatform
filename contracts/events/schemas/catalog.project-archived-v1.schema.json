{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/catalog.project-archived-v1.schema.json",
  "title": "Project archived",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "catalog.project_archived" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "Project" },
        "aggregateVersion": { "type": "integer", "minimum": 1 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectId", "code", "fromLifecycle", "toLifecycle", "rowVersion", "mode", "blockers"],
          "properties": {
            "projectId": { "type": "string", "format": "uuid" },
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
            "fromLifecycle": { "const": "ACTIVE" },
            "toLifecycle": { "const": "ARCHIVED" },
            "rowVersion": { "type": "integer", "minimum": 1 },
            "mode": { "enum": ["NORMAL", "GOVERNANCE_OVERRIDE"] },
            "blockers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "count"],
                "properties": {
                  "code": { "enum": ["OPEN_WORK_ITEMS", "PENDING_WORKLOG_APPROVALS", "OPEN_PRODUCT_FEEDBACK"] },
                  "count": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  ]
}
