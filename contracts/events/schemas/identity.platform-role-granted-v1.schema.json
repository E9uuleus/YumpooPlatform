{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/identity.platform-role-granted-v1.schema.json",
  "title": "Platform role granted",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "identity.platform_role_granted" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "PlatformRoleAssignment" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assignmentId", "userId", "roleCode", "scopeType", "scopeId", "reasonReference", "authorizationVersion"],
          "properties": {
            "assignmentId": { "type": "string", "format": "uuid" },
            "userId": { "type": "string", "format": "uuid" },
            "roleCode": { "enum": ["APP_MANAGER", "COMPANY_ADMIN"] },
            "scopeType": { "enum": ["PLATFORM", "COMPANY"] },
            "scopeId": { "type": "string", "format": "uuid" },
            "reasonReference": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*" },
            "authorizationVersion": { "type": "integer", "minimum": 1 }
          },
          "allOf": [
            { "if": { "properties": { "roleCode": { "const": "APP_MANAGER" } } }, "then": { "properties": { "scopeType": { "const": "PLATFORM" } } } },
            { "if": { "properties": { "roleCode": { "const": "COMPANY_ADMIN" } } }, "then": { "properties": { "scopeType": { "const": "COMPANY" } } } }
          ]
        }
      }
    }
  ]
}
