{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/workitem.work-item-unarchived-v1.schema.json",
  "title": "Work item unarchived v1",
  "allOf": [
    {
      "$ref": "event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "workitem.work_item_unarchived"
        },
        "eventVersion": {
          "const": 1
        },
        "aggregateType": {
          "const": "WorkItem"
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workItemId",
            "projectId",
            "contentId",
            "itemNo",
            "title",
            "statusCode",
            "statusCategory",
            "priority",
            "rowVersion",
            "archived"
          ],
          "properties": {
            "workItemId": {
              "type": "string",
              "format": "uuid"
            },
            "projectId": {
              "type": "string",
              "format": "uuid"
            },
            "contentId": {
              "type": "string",
              "format": "uuid"
            },
            "itemNo": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "statusCode": {
              "type": "string"
            },
            "statusCategory": {
              "enum": [
                "TODO",
                "IN_PROGRESS",
                "DONE",
                "CANCELED"
              ]
            },
            "priority": {
              "type": [
                "string",
                "null"
              ]
            },
            "rowVersion": {
              "type": "integer",
              "minimum": 1
            },
            "archived": {
              "type": "boolean",
              "const": false
            }
          }
        }
      }
    }
  ]
}
