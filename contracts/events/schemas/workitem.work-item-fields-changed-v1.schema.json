{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/events/workitem.work-item-fields-changed-v1.schema.json",
  "title": "Work Item fields changed",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    { "type": "object", "properties": {
      "eventType": { "const": "workitem.work_item_fields_changed" },
      "eventVersion": { "const": 1 },
      "aggregateType": { "const": "WorkItem" },
      "aggregateVersion": { "type": "integer", "minimum": 1 },
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workItemId", "projectId", "contentId", "itemNo", "title", "workItemType", "statusCode", "statusCategory", "priority", "assigneeUserId", "timelineStartDate", "timelineEndDate", "dueDate", "rowVersion", "changedFields"],
        "properties": {
          "workItemId": { "type": "string", "format": "uuid" },
          "projectId": { "type": "string", "format": "uuid" },
          "contentId": { "type": "string", "format": "uuid" },
          "itemNo": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[1-9][0-9]*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "workItemType": { "enum": ["REQUIREMENT", "TASK", "DEFECT"] },
          "statusCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
          "statusCategory": { "enum": ["TODO", "IN_PROGRESS", "DONE", "CANCELED"] },
          "priority": { "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] },
          "assigneeUserId": { "type": ["string", "null"], "format": "uuid" },
          "timelineStartDate": { "type": ["string", "null"], "format": "date" },
          "timelineEndDate": { "type": ["string", "null"], "format": "date" },
          "dueDate": { "type": ["string", "null"], "format": "date" },
          "rowVersion": { "type": "integer", "minimum": 1 },
          "changedFields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["title", "priority", "assigneeUserId", "description", "notes", "timelineStartDate", "timelineEndDate", "dueDate"] }
          }
        }
      }
    } }
  ]
}
