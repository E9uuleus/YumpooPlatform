{
  "schemaVersion": 1,
  "milestone": "M2-23",
  "compatibilityPolicy": "OPTIONAL_FIELDS_ONLY",
  "consumerPolicy": {
    "requiresCurrentAuthorization": true,
    "notificationSafePayload": "TARGET_REFERENCES_ONLY",
