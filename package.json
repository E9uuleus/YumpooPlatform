{
  "name": "yumpoo-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.14.x",
    "pnpm": "11.16.x"
  },
  "scripts": {
    "verify:deployment-config": "node tools/verification/verify-deployment-config.mjs",
    "generate:brand-assets": "node tools/branding/generate-assets.mjs",
    "check:brand-assets": "node tools/branding/generate-assets.mjs --check",
    "ci": "node tools/ci/run.mjs",
    "ci:static": "node tools/ci/run.mjs static",
    "ci:contracts": "node tools/ci/run.mjs contracts",
    "ci:backend": "node tools/ci/run.mjs backend",
    "ci:portable": "node tools/ci/run.mjs portable",
    "ci:windows": "node tools/ci/run.mjs windows",
    "test:ci": "node --test --test-isolation=none tools/ci/ci.test.mjs tools/ci/migration-policy.test.mjs tools/ci/release-workflows.test.mjs tools/openapi/breaking-change-policy.test.mjs",
    "test:openapi-compat": "node --test --test-isolation=none tools/openapi/openapi-compat.test.mjs",
    "dev:web": "pnpm --filter @yumpoo/api-client build && pnpm --filter @yumpoo/web-app dev",
    "dev:desktop": "pnpm --filter @yumpoo/preload-contract build && pnpm --filter @yumpoo/desktop-shell start",
    "lint:openapi": "node tools/openapi/lint-openapi.mjs",
    "validate:openapi-examples": "node tools/openapi/validate-golden-examples.mjs",
    "generate:api-client": "node tools/openapi/api-client-codegen.mjs generate",
    "check:api-client": "node tools/openapi/api-client-codegen.mjs check",
    "check:openapi": "pnpm run lint:openapi && pnpm run validate:openapi-examples && pnpm run check:api-client",
    "validate:event-contracts": "node tools/events/validate-event-contracts.mjs",
    "check:event-contract-compat": "node tools/events/check-event-contract-compat.mjs",
    "test:event-contract-compat": "node --test --test-isolation=none tools/events/event-contract-compat.test.mjs",
    "audit:workitem-event-inventory": "node tools/events/audit-workitem-event-inventory.mjs",
    "check:openapi-compat": "node tools/openapi/check-openapi-compat.mjs",
    "verify-md-links": "tsx scripts/verify-md-links.ts",
    "verify-agent-notes": "tsx scripts/verify-agent-notes.ts",
    "verify-archived-agent-notes": "tsx scripts/verify-archived-agent-notes.ts",
    "test:agent-notes": "vitest run scripts/verify-agent-notes.spec.ts scripts/archived-agent-notes.spec.ts",
    "doc-sync": "pnpm run verify-md-links && pnpm run verify-agent-notes && pnpm run verify-archived-agent-notes",
    "lint": "eslint \"frontend/**/*.{ts,vue}\" \"desktop/**/*.ts\" \"packages/**/*.ts\"",
    "test:architecture": "node --test tools/architecture/workspace-boundaries.test.mjs tools/verification/unified-project-model.test.mjs",
    "typecheck": "pnpm --filter @yumpoo/preload-contract build && pnpm --filter @yumpoo/api-client typecheck && pnpm --filter @yumpoo/api-client build && pnpm --filter @yumpoo/web-app typecheck && pnpm --filter @yumpoo/desktop-shell typecheck",
    "test": "pnpm --filter @yumpoo/api-client test && pnpm --filter @yumpoo/web-app test && pnpm --filter @yumpoo/desktop-shell test",
    "build": "pnpm --filter @yumpoo/preload-contract build && pnpm --filter @yumpoo/api-client build && pnpm --filter @yumpoo/web-app build && pnpm --filter @yumpoo/desktop-shell build",
    "verify:node": "pnpm run check:openapi && pnpm run lint && pnpm run test:architecture && pnpm run typecheck && pnpm run test && pnpm run build",
    "package:desktop:win": "node tools/verification/package-desktop-win.mjs",
    "verify:desktop:update": "node tools/verification/verify-desktop-update.mjs",
    "smoke:desktop": "node tools/verification/smoke-desktop.mjs",
    "test:delivery": "node --test --test-isolation=none tools/verification/delivery.test.mjs tools/verification/desktop-profile.test.mjs tools/verification/collect-desktop-release.test.mjs",
    "package:server:win": "node tools/verification/package-server-win.mjs",
    "verify:server:package": "node tools/verification/verify-server-package.mjs",
    "verify:content-category-refactor:assets": "node tools/verification/verify-content-category-refactor-assets.mjs"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@redocly/cli": "2.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "mdast-util-from-markdown": "2.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "yaml": "2.9.1"
  }
}
