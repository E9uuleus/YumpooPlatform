{
  "name": "yumpoo-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.14.x",
    "pnpm": "11.16.x"
  },
  "scripts": {
    "dev:web": "pnpm --filter @yumpoo/web-app dev",
    "dev:desktop": "pnpm --filter @yumpoo/preload-contract build && pnpm --filter @yumpoo/desktop-shell start",
    "lint": "eslint \"frontend/**/*.{ts,vue}\" \"desktop/**/*.ts\" \"packages/**/*.ts\"",
    "test:architecture": "node --test tools/architecture/workspace-boundaries.test.mjs",
    "typecheck": "pnpm --filter @yumpoo/preload-contract build && pnpm --filter @yumpoo/web-app typecheck && pnpm --filter @yumpoo/desktop-shell typecheck",
    "test": "pnpm --filter @yumpoo/web-app test && pnpm --filter @yumpoo/desktop-shell test",
    "build": "pnpm --filter @yumpoo/preload-contract build && pnpm --filter @yumpoo/web-app build && pnpm --filter @yumpoo/desktop-shell build",
    "verify:node": "pnpm run lint && pnpm run test:architecture && pnpm run typecheck && pnpm run test && pnpm run build",
    "verify:m0-07": "node tools/verification/verify-m0-07.mjs",
    "verify:m0-08": "pnpm run verify:m0-07",
    "smoke:desktop": "node tools/verification/smoke-desktop.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "typescript": "5.9.3",
    "vue-eslint-parser": "10.3.0"
  }
}
