{
  "name": "yumpoo-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.14.x",
    "pnpm": "11.16.x"
  },
  "scripts": {
    "dev:web": "pnpm --filter @yumpoo/web-app dev",
    "lint": "eslint \"frontend/**/*.{ts,vue}\"",
    "typecheck": "pnpm --filter @yumpoo/web-app typecheck",
    "test": "pnpm --filter @yumpoo/web-app test",
    "build": "pnpm --filter @yumpoo/web-app build",
    "verify:node": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "typescript": "5.9.3",
    "vue-eslint-parser": "10.3.0"
  }
}
