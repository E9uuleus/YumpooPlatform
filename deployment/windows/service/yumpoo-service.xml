<?xml version="1.0" encoding="utf-8"?>
<service>
  <id>YumpooServer</id>
  <name>Yumpoo Server</name>
  <description>YumpooPlatform Spring Boot backend</description>
  <executable>%YUMPOO_JAVA_HOME%\bin\java.exe</executable>
  <arguments>-Dfile.encoding=UTF-8 -jar "%YUMPOO_RELEASE_ROOT%\server\yumpoo-server.jar"</arguments>
  <workingdirectory>%YUMPOO_RELEASE_ROOT%</workingdirectory>
  <env name="SPRING_PROFILES_ACTIVE" value="prod" />
  <env name="SPRING_CONFIG_ADDITIONAL_LOCATION" value="file:C:/ProgramData/Yumpoo/config/,file:C:/ProgramData/Yumpoo/secrets/application-secrets.yml" />
  <env name="YUMPOO_SERVER_PORT" value="8100" />
  <startmode>Automatic</startmode>
  <delayedAutoStart />
  <depend>postgresql-x64-17</depend>
  <stoptimeout>60 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="none" />
  <resetfailure>1 hour</resetfailure>
  <logpath>C:\ProgramData\Yumpoo\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <stopparentprocessfirst>true</stopparentprocessfirst>
</service>
