{
  "schemaVersion": 1,
  "milestone": "M0-16",
  "mode": "DRY_RUN_ONLY",
  "target": {
    "operatingSystem": "Windows Server 2022",
    "architecture": "x64",
    "publicPort": 443,
    "frontendAddress": "127.0.0.1",
    "frontendPort": 18173,
    "backendAddress": "127.0.0.1",
    "backendPort": 8100
  },
  "reverseProxy": {
    "product": "NGINX",
    "configuration": "nginx/yumpoo-wecom.conf",
    "publicServerName": "wecom-dev.yumpoo.com"
  },
  "checks": [
    "cleanWindowsServer2022",
    "trustedHttpsCertificate",
    "only443Public",
    "frontendBackendAndDatabasePortsIsolated",
    "dedicatedLowPrivilegeServiceAccount",
    "interactiveLogonDenied",
    "ntfsAclApplied",
    "persistentDataSurvivesUpgrade",
    "wholeMachineRestartRecovery",
    "logsAndEvidenceRedacted"
  ],
  "orderedActions": {
    "install": ["preflight", "createPersistentDirectories", "applyAcl", "deployRelease", "installWinSwWithPrompt", "configureNginx", "startPostgreSql", "startYumpoo", "probeHealth"],
    "upgrade": ["stageNewRelease", "stopYumpoo", "switchCurrentRelease", "startYumpoo", "probeHealth", "preservePersistentDirectories"],
    "rollback": ["stopYumpoo", "switchPreviousRelease", "startYumpoo", "probeHealth", "preservePersistentDirectories"],
    "restart": ["startPostgreSql", "waitDatabaseReady", "startYumpoo", "probeLiveness", "probeReadiness", "enableNginxTraffic"]
  }
}
