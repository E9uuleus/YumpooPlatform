{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/evidence/m0-13/live-verification.schema.json",
  "title": "M0-13 WeCom directory live verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "milestone",
    "status",
    "verifiedAt",
    "corpFingerprint",
    "snapshotFingerprint",
    "m012DependencyStatus",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "milestone": {
      "const": "M0-13"
    },
    "status": {
      "enum": ["NOT_RUN", "PASS"]
    },
    "verifiedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "corpFingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshotFingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "m012DependencyStatus": {
      "enum": ["NOT_RUN", "PASS"]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationPreflight",
        "realDirectoryRead",
        "providerPaginationObserved",
        "providerTerminalCursorOmissionConfirmed",
        "rerunIdempotent",
        "pageFailureSafe",
        "itemFailurePartialSafe",
        "syntheticDepartureDetected",
        "syntheticReturnReused",
        "secretsRedacted",
        "externalLimitsRecorded",
        "signedReceiptVerified"
      ],
      "properties": {
        "configurationPreflight": {
          "type": "boolean"
        },
        "realDirectoryRead": {
          "type": "boolean"
        },
        "providerPaginationObserved": {
          "type": "boolean"
        },
        "providerTerminalCursorOmissionConfirmed": {
          "type": "boolean"
        },
        "rerunIdempotent": {
          "type": "boolean"
        },
        "pageFailureSafe": {
          "type": "boolean"
        },
        "itemFailurePartialSafe": {
          "type": "boolean"
        },
        "syntheticDepartureDetected": {
          "type": "boolean"
        },
        "syntheticReturnReused": {
          "type": "boolean"
        },
        "secretsRedacted": {
          "type": "boolean"
        },
        "externalLimitsRecorded": {
          "type": "boolean"
        },
        "signedReceiptVerified": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NOT_RUN"
          }
        }
      },
      "then": {
        "properties": {
          "verifiedAt": {
            "type": "null"
          },
          "corpFingerprint": {
            "type": "null"
          },
          "snapshotFingerprint": {
            "type": "null"
          },
          "m012DependencyStatus": {
            "const": "NOT_RUN"
          },
          "checks": {
            "properties": {
              "configurationPreflight": {
                "const": false
              },
              "realDirectoryRead": {
                "const": false
              },
              "providerPaginationObserved": {
                "const": false
              },
              "providerTerminalCursorOmissionConfirmed": {
                "const": false
              },
              "rerunIdempotent": {
                "const": false
              },
              "pageFailureSafe": {
                "const": false
              },
              "itemFailurePartialSafe": {
                "const": false
              },
              "syntheticDepartureDetected": {
                "const": false
              },
              "syntheticReturnReused": {
                "const": false
              },
              "secretsRedacted": {
                "const": false
              },
              "externalLimitsRecorded": {
                "const": false
              },
              "signedReceiptVerified": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "corpFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "snapshotFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "checks": {
            "properties": {
              "configurationPreflight": {
                "const": true
              },
              "realDirectoryRead": {
                "const": true
              },
              "providerPaginationObserved": {
                "const": true
              },
              "providerTerminalCursorOmissionConfirmed": {
                "const": true
              },
              "rerunIdempotent": {
                "const": true
              },
              "pageFailureSafe": {
                "const": true
              },
              "itemFailurePartialSafe": {
                "const": true
              },
              "syntheticDepartureDetected": {
                "const": true
              },
              "syntheticReturnReused": {
                "const": true
              },
              "secretsRedacted": {
                "const": true
              },
              "externalLimitsRecorded": {
                "const": true
              },
              "signedReceiptVerified": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
