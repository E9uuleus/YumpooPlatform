{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/evidence/m0-18/evidence-manifest.schema.json",
  "title": "M0-18 development evidence pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "milestone", "generatedAt", "sourceCommit", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "milestone": { "const": "M0-18" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "files": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]+$" },
          "role": { "enum": ["VERIFICATION_REPORT", "DEFERRED_ACCEPTANCE", "PORTABLE_HANDOFF", "M015_MANIFEST", "M016_MANIFEST", "M016_ZIP_DIGEST", "M017_BACKUP_MANIFEST", "M017_RETENTION_PLAN", "M017_VERIFICATION_REPORT"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
