{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/evidence/m1-13/acceptance-matrix.schema.json",
  "title": "M1-13 identity foundation acceptance matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "milestone", "requirements", "coverage", "deferred"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "milestone": { "const": "M1-13" },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iam", "acl", "api"],
      "properties": {
        "iam": { "$ref": "#/definitions/idList" },
        "acl": { "$ref": "#/definitions/idList" },
        "api": { "$ref": "#/definitions/idList" }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidencePath", "requirementIds"],
        "properties": {
          "evidencePath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "requirementIds": { "$ref": "#/definitions/idList" }
        }
      }
    },
    "deferred": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m2Acl", "liveVerifications"],
      "properties": {
        "m2Acl": { "$ref": "#/definitions/idList" },
        "liveVerifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["milestone", "evidencePath", "targetGate"],
            "properties": {
              "milestone": { "type": "string", "pattern": "^M[01]-[0-9]{2}$" },
              "evidencePath": { "type": "string", "pattern": "^evidence/m[01]-[0-9]{2}/live-verification\\.json$" },
              "targetGate": { "const": "M6-01" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(IAM|ACL|API)-[0-9]{3}$" }
    }
  }
}
