{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/evidence/m0-17/retention-plan.schema.json",
  "title": "M0-17 retention dry-run plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "milestone", "companyTimeZone", "decisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "milestone": { "const": "M0-17" },
    "companyTimeZone": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backupSetId", "verifiedAt", "verified", "labels", "legalHold", "deletionEligible"],
        "properties": {
          "backupSetId": { "type": "string", "format": "uuid" },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "verified": { "type": "boolean" },
          "labels": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["daily", "weekly", "monthly"] }
          },
          "legalHold": { "type": "boolean" },
          "deletionEligible": { "type": "boolean" }
        }
      }
    }
  }
}
