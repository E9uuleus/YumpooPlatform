{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.yumpoo.local/evidence/m0-16/live-verification.schema.json",
  "title": "M0-16 Windows deployment target evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "milestone", "status", "verifiedAt", "operatingSystem", "architecture", "artifactZipSha256", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "milestone": { "const": "M0-16" },
    "status": { "enum": ["NOT_RUN", "PASS"] },
    "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
    "operatingSystem": { "enum": [null, "WINDOWS_SERVER_2022"] },
    "architecture": { "enum": [null, "x64"] },
    "artifactZipSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanServer", "trustedHttps", "only443Public", "portsIsolated", "dedicatedLowPrivilegeAccount", "interactiveLogonDenied", "aclVerified", "persistentDataPreservedOnUpgrade", "wholeMachineRestartRecovered", "healthSemanticsVerified", "sensitiveDataRedacted", "signedReceiptVerified"],
      "properties": {
        "cleanServer": { "type": "boolean" },
        "trustedHttps": { "type": "boolean" },
        "only443Public": { "type": "boolean" },
        "portsIsolated": { "type": "boolean" },
        "dedicatedLowPrivilegeAccount": { "type": "boolean" },
        "interactiveLogonDenied": { "type": "boolean" },
        "aclVerified": { "type": "boolean" },
        "persistentDataPreservedOnUpgrade": { "type": "boolean" },
        "wholeMachineRestartRecovered": { "type": "boolean" },
        "healthSemanticsVerified": { "type": "boolean" },
        "sensitiveDataRedacted": { "type": "boolean" },
        "signedReceiptVerified": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "NOT_RUN" } } },
      "then": {
        "properties": {
          "verifiedAt": { "type": "null" },
          "operatingSystem": { "type": "null" },
          "architecture": { "type": "null" },
          "artifactZipSha256": { "type": "null" },
          "checks": { "properties": {
            "cleanServer": { "const": false }, "trustedHttps": { "const": false }, "only443Public": { "const": false }, "portsIsolated": { "const": false }, "dedicatedLowPrivilegeAccount": { "const": false }, "interactiveLogonDenied": { "const": false }, "aclVerified": { "const": false }, "persistentDataPreservedOnUpgrade": { "const": false }, "wholeMachineRestartRecovered": { "const": false }, "healthSemanticsVerified": { "const": false }, "sensitiveDataRedacted": { "const": false }, "signedReceiptVerified": { "const": false }
          } }
        }
      },
      "else": {
        "properties": {
          "verifiedAt": { "type": "string", "format": "date-time" },
          "operatingSystem": { "const": "WINDOWS_SERVER_2022" },
          "architecture": { "const": "x64" },
          "artifactZipSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "checks": { "properties": {
            "cleanServer": { "const": true }, "trustedHttps": { "const": true }, "only443Public": { "const": true }, "portsIsolated": { "const": true }, "dedicatedLowPrivilegeAccount": { "const": true }, "interactiveLogonDenied": { "const": true }, "aclVerified": { "const": true }, "persistentDataPreservedOnUpgrade": { "const": true }, "wholeMachineRestartRecovered": { "const": true }, "healthSemanticsVerified": { "const": true }, "sensitiveDataRedacted": { "const": true }, "signedReceiptVerified": { "const": true }
          } }
        }
      }
    }
  ]
}
